{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "checkJs": true,
    "noImplicitAny": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "/*": ["./web/*"]
    }
  },
  "include": ["web/js/**/*.js"],
  "exclude": ["node_modules"]
}
