# Mohlat environment configuration
# Copy to .env and fill in your values

# LLM backend: "aistudio" (API key) or "vertex" (service identity)
LLM_BACKEND=aistudio

# Google AI Studio API key (required when LLM_BACKEND=aistudio)
GEMINI_API_KEY=your-api-key-here

# Gemini model id. "gemini-flash-latest" always resolves to the current
# Flash-tier model, so a retirement cannot break the app. Pin an exact id
# (for example gemini-3.8-flash) when you need a reproducible build.
# Check what your key can call:
#   curl -s -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models | grep '"name"'
GEMINI_MODEL=gemini-flash-latest

# Tried in order when the model above is retired (404), rate limited (429) or
# overloaded (5xx). Leave empty to disable failover.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-2.5-flash

# Vertex AI settings (required when LLM_BACKEND=vertex)
# GCP_PROJECT=your-project-id
# GCP_LOCATION=asia-south1

# Application environment: "dev" or "prod"
APP_ENV=dev

# Trust X-Forwarded-For (set true behind a proxy like Cloud Run)
TRUST_PROXY=false

# How many proxies sit in front of the app. The client address is counted in
# from the right of X-Forwarded-For, because a caller can write anything into
# the left of it. One is right for Cloud Run without a custom load balancer.
TRUSTED_PROXY_HOPS=1

# Rate limiting: requests per client per minute on AI endpoints
RATE_LIMIT_PER_MINUTE=10

# Cache: how long a result can be reused for an identical request (seconds)
CACHE_TTL_SECONDS=900

# Output budget per task. Generous on purpose: the newer Gemini models spend
# reasoning tokens from this same budget, and a cap that only just fits the
# answer truncates it mid-JSON. Unused headroom is not billed.
MAX_OUTPUT_TOKENS_DECODE=16384
MAX_OUTPUT_TOKENS_CROSS_CHECK=16384
MAX_OUTPUT_TOKENS_ASK=4096
